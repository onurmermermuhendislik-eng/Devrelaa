# ALTEZ MiniLab V7 - ORNEK ortam degiskenleri. Gercek degerleri .env dosyasina YAZIP depoya/ZIP'e KOYMAYIN.
# Uygulamanin kendisi hicbir gizli anahtar kullanmaz (cevrimdisi). Bunlar yalnizca derleme makinesi icindir.
# Shell'de elle ayarlayin:  export ANDROID_HOME=/usr/lib/android-sdk
ANDROID_HOME=/usr/lib/android-sdk
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# Tarayici testi icin (Playwright proje bagimliligi degildir):
# PLAYWRIGHT_PATH=/usr/lib/node_modules/playwright
# Betik secenekleri:
# OUT_DIR=/home/altez/altez-minilab-v7-out-ozel
# SKIP_SMOKE=1
# SKIP_ANDROID=1
